# Local demo defaults. Never commit real provider keys.
DATABASE_URL=postgresql+asyncpg://auditor:auditor_local@127.0.0.1:55432/auditor
REDIS_URL=redis://127.0.0.1:56379/0
DATA_DIR=.data
DEMO_ENABLED=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
MODEL_DEVICE=cpu
# Optional remote claim extraction and verification. local_nli works without an API key.
AUDIT_PROVIDER=local_nli
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5
